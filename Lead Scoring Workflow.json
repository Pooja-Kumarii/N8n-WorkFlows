        "jsonBody": "={\n  \"model\": \"meta-llama/llama-3.1-8b-instruct\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a strict lead qualification expert.\\n\\nSCORING RULES (1-10):\\n- Budget mentioned (50k+): +3 points\\n- Decision maker (CEO/Manager/Head): +3 points\\n- Fit keywords (automation/scale/enterprise/urgent): +2 points\\n- Clear problem statement (specific use case): +2 points\\n\\nEDGE CASES — Score 1 if:\\n- Message is gibberish or random characters\\n- Message is too vague (less than 10 words)\\n- No company or role mentioned at all\\n- Looks like spam or test message\\n\\nRespond ONLY in this exact JSON format, nothing else:\\n{\\\"score\\\": <1-10>, \\\"reasoning\\\": \\\"<one sentence max>\\\"}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ 'Score this lead:\\\\nName: ' + $('Webhook1').item.json.body.name + '\\\\nCompany: ' + $('Webhook1').item.json.body.company + '\\\\nMessage: ' + $('Webhook1').item.json.body.message }}\"\n    }\n  ]\n}",
        "options": {}
